# Copy to server/.env (git-ignored) and replace every change-me value.
HALQO_DB_USER=halqo
HALQO_DB_PASSWORD=change-me
# Windows host LAN IP (same as LAN_IP in infra/.env), so phones can use presigned URLs.
HALQO_S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000
HALQO_S3_ACCESS_KEY=halqo-app
HALQO_S3_SECRET_KEY=change-me
# Bucket defaults to halqo-media (tests always use halqo-media-test); region defaults to us-east-1.
# HALQO_S3_BUCKET=halqo-media
# HALQO_S3_REGION=us-east-1

# Native core built with: cd core && cargo build --features jni --profile server
# Defaults to ../core/target/server/<halqo_core.dll|libhalqo_core.so>.
# HALQO_CORE_LIBRARY=

# Server secrets (CRYPTO.md section 13). Generate real values with GenerateSecrets (see docs/DEV_SETUP.md);
# never reuse local values in production, and never commit them.
HALQO_OPAQUE_SERVER_SETUP=change-me
HALQO_HANDLE_KEY=change-me
HALQO_PUSH_TOKEN_KEY=change-me
HALQO_JWT_KEY=change-me

# Moderation public key from `cargo run --bin halqo-moderation -- keygen` (keep the secret offline).
HALQO_MODERATION_PUBLIC_KEY=change-me
# Content-free push via FCM (optional; empty = off). The service account JSON comes from your secret store.
HALQO_FCM_PROJECT_ID=
HALQO_FCM_SERVICE_ACCOUNT=
