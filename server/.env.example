# Copy to server/.env (git-ignored) and replace every change-me value.
CIRCLO_DB_USER=circlo
CIRCLO_DB_PASSWORD=change-me
# Windows host LAN IP (same as LAN_IP in infra/.env), so phones and browsers can use presigned URLs.
CIRCLO_S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000
CIRCLO_S3_ACCESS_KEY=circlo-app
CIRCLO_S3_SECRET_KEY=change-me
# Bucket defaults to circlo-media (tests always use circlo-media-test); region defaults to us-east-1.
# CIRCLO_S3_BUCKET=circlo-media
# CIRCLO_S3_REGION=us-east-1

# Behind a reverse proxy: regex of the proxy IPs whose X-Forwarded-For is trusted (docs/HARDENING.md). Empty = none.
# CIRCLO_TRUSTED_PROXIES=

# Signs session tokens. Generate with GenerateSecrets (docs/DEV_SETUP.md); never reuse local values in production.
CIRCLO_JWT_KEY=change-me

# Email (verification and password-reset codes). In the local profile codes are printed to the console unless
# CIRCLO_MAIL_MODE=smtp. Production needs an SMTP server.
# CIRCLO_MAIL_MODE=smtp
# CIRCLO_MAIL_HOST=smtp.example.com
# CIRCLO_MAIL_PORT=587
# CIRCLO_MAIL_USERNAME=change-me
# CIRCLO_MAIL_PASSWORD=change-me
# CIRCLO_MAIL_FROM=Circlo <no-reply@hellocirclo.com>

# Browser origins of the web app, comma-separated (local profile default: http://localhost:8081).
# CIRCLO_CORS_ORIGINS=https://app.hellocirclo.com

# Optional: database connection pool size (default 24).
# CIRCLO_DB_POOL_SIZE=24
