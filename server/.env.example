# Copy to server/.env (git-ignored) and replace every change-me value.
CIRCLO_DB_USER=circlo
CIRCLO_DB_PASSWORD=change-me
# Windows host LAN IP (same as LAN_IP in infra/.env), so phones can use presigned URLs.
CIRCLO_S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000
CIRCLO_S3_ACCESS_KEY=circlo-app
CIRCLO_S3_SECRET_KEY=change-me
# Bucket defaults to circlo-media (tests always use circlo-media-test); region defaults to us-east-1.
# CIRCLO_S3_BUCKET=circlo-media
# CIRCLO_S3_REGION=us-east-1

# Native core built with: cd core && cargo build --features jni --profile server
# Defaults to ../core/target/server/<circlo_core.dll|libcirclo_core.so>.
# CIRCLO_CORE_LIBRARY=

# Behind a reverse proxy: regex of the proxy IPs whose X-Forwarded-For is trusted (docs/HARDENING.md). Empty = none.
# CIRCLO_TRUSTED_PROXIES=

# Server secrets (CRYPTO.md section 13). Generate real values with GenerateSecrets (see docs/DEV_SETUP.md);
# never reuse local values in production, and never commit them.
CIRCLO_OPAQUE_SERVER_SETUP=change-me
CIRCLO_HANDLE_KEY=change-me
CIRCLO_PUSH_TOKEN_KEY=change-me
CIRCLO_JWT_KEY=change-me

# Content-free push via FCM (optional; empty = off). The service account JSON comes from your secret store.
CIRCLO_FCM_PROJECT_ID=
CIRCLO_FCM_SERVICE_ACCOUNT=
# Optional: database connection pool size (default 24).
# CIRCLO_DB_POOL_SIZE=24
