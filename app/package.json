    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
