{
  "name": "@circlo/core",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Circlo crypto core (Rust circlo-core) for React Native, generated by uniffi-bindgen-react-native (jsi2)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zbaloch/circlo.git",
    "directory": "app/modules/circlo-core"
  },
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "types": "src/index.tsx",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec"
  ],
  "scripts": {
    "ubrn:android": "ubrn build jsi2 android --and-generate --config ubrn.config.yaml",
    "ubrn:ios": "ubrn build jsi2 ios --and-generate --config ubrn.config.yaml",
    "ubrn:android:release": "ubrn build jsi2 android --profile app --and-generate --config ubrn.config.yaml",
    "ubrn:ios:release": "ubrn build jsi2 ios --profile app --and-generate --config ubrn.config.yaml"
  },
  "codegenConfig": {
    "android": {
      "javaPackageName": "com.circlo.core"
    }
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6"
  },
  "peerDependencies": {
    "@ubjs/react-native": "0.31.0-6"
  },
  "devDependencies": {
    "uniffi-bindgen-react-native": "0.31.0-6",
    "@ubjs/react-native": "^0.31.0-6"
  }
}
