# Copy to infra/.env (git-ignored) and replace every change-me value.
MINIO_ROOT_USER=circlo-root
MINIO_ROOT_PASSWORD=change-me
MINIO_APP_USER=circlo-app
MINIO_APP_PASSWORD=change-me
# Windows host's Wi-Fi/Ethernet IPv4 from `ipconfig` (WSL mirrored networking).
LAN_IP=192.168.1.50
# Optional: name of an already-existing MinIO container to reuse instead of the compose service.
# MINIO_CONTAINER=circlo-minio
